PORT=3000
NODE_ENV=development
DATABASE_URL=
REDIS_URL=

# Default stays on the existing direct Baileys transport until an Evolution service is configured.
# Switch to "evolution" only after EVOLUTION_* and PUBLIC_BASE_URL are set and tested.
WHATSAPP_PROVIDER=baileys
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
PUBLIC_BASE_URL=

LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
TTS_PROVIDER=
TTS_API_KEY=
STT_PROVIDER=
STT_API_KEY=

# Natural WhatsApp voice notes (Opus 48 kHz)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Speech-to-text can use a provider separate from the chat model.
OPENAI_API_KEY=
STT_BASE_URL=https://api.openai.com
STT_MODEL=gpt-4o-mini-transcribe

# Address search and verified coordinates.
GOOGLE_MAPS_API_KEY=
